    "id": "qsofa",
    "name": "qSOFA Score",
    "shortName": "qSOFA",
    "whenToUse": "Outside ICU, patients with suspected infection.",
    "whyUse": "Simple screen for organ dysfunction risk; not a diagnostic criteria for sepsis alone.",
    "nextSteps": [
      {
        "condition": "qSOFA ≥2",
        "actions": [
          "Measure lactate",
          "Blood cultures before antibiotics if no delay",
          "Broad-spectrum antibiotics for suspected sepsis",
          "Fluid resuscitation and source control"
        ]
      }
    ]
  },
  {
    "file": "critical-care.ts",
