    "name": "Glasgow Coma Scale (GCS)",
    "shortName": "GCS",
    "whenToUse": "Altered mental status, trauma, ICU sedation assessment.",
    "whyUse": "Universal language for neurologic status and triage.",
    "nextSteps": [
      {
        "condition": "GCS ≤ 8",
        "actions": [
          "Airway assessment / RSI as indicated",
          "Urgent CT head if trauma/unknown cause",
          "Treat reversible causes (glucose, opioids, etc.)"
        ]
      },
      {
        "condition": "Any drop ≥2 points",
        "actions": [
          "Urgent reassessment",
          "Repeat imaging as indicated"
        ]
      }
    ]
  },
