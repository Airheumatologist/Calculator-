    "name": "SOFA Score",
    "shortName": "SOFA",
    "whenToUse": "ICU patients, especially suspected sepsis, to track organ dysfunction.",
    "whyUse": "Sepsis-3 defines organ dysfunction as acute change in SOFA ≥2.",
    "nextSteps": [
      {
        "condition": "Acute increase ≥2 with infection",
        "actions": [
          "Treat as sepsis",
          "Hour-1 bundle elements",
          "ICU-level care as needed"
        ]
      }
    ]
  },
